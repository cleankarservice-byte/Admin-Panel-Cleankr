rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Core authentication check
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper to fetch the admin's database record
    function getAdminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Strictly verified Admin check - accounts for both Custom Claims and the /admins collection
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.admin == true) ||
        (request.auth.token.role in ['SUPER_ADMIN', 'OPERATIONS_ADMIN', 'FINANCE_ADMIN', 'SUPPORT_ADMIN', 'READ_ONLY_ADMIN']) ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         getAdminDoc().data.isActive == true)
      );
    }

    // Role-based privilege verification
    function hasAdminRole(role) {
      return isAdmin() && (
        request.auth.token.admin == true ||
        request.auth.token.role == role || 
        request.auth.token.role == 'SUPER_ADMIN' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         getAdminDoc().data.isActive == true &&
         getAdminDoc().data.role in [role, 'SUPER_ADMIN'])
      );
    }

    // Super Admin privilege
    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'SUPER_ADMIN' ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && 
         getAdminDoc().data.isActive == true &&
         getAdminDoc().data.role == 'SUPER_ADMIN')
      );
    }

    // Identity verification for Customer
    function isCustomer(customerId) {
      return isAuthenticated() && request.auth.uid == customerId;
    }

    // Identity verification for Partner
    function isPartner(partnerId) {
      return isAuthenticated() && (
        request.auth.uid == partnerId ||
        (exists(/databases/$(database)/documents/partners/$(partnerId)) &&
         get(/databases/$(database)/documents/partners/$(partnerId)).data.uid == request.auth.uid)
      );
    }

    // ==========================================
    // 1. DEFAULT DENY: All paths blocked by default
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 2. ADMIN USER DIRECTORY
    // Super Admin only can create/modify administrative accounts
    // ==========================================
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }

    // ==========================================
    // 3. AUDIT LOGS
    // Append-only by active admins. NEVER editable or deletable.
    // ==========================================
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && 
                       request.resource.data.adminEmail != null &&
                       request.resource.data.action != null &&
                       request.resource.data.timestamp != null;
      allow update, delete: if false;
    }

    // ==========================================
    // 4. SECURITY ALERTS & SYSTEM INCIDENTS
    // ==========================================
    match /security_alerts/{alertId} {
      allow read: if isAdmin();
      allow write: if hasAdminRole('SUPER_ADMIN');
    }

    // ==========================================
    // 5. CUSTOMER PROFILES (Customer App compatibility)
    // Customers can only read/edit their own profile
    // ==========================================
    match /customers/{customerId} {
      allow read: if isAdmin() || isCustomer(customerId);
      allow create: if isAuthenticated() && request.auth.uid == customerId;
      allow update: if (isCustomer(customerId) && 
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'rating', 'totalSpent', 'totalBookings'])) 
                    || isAdmin();
      allow delete: if isSuperAdmin();
    }

    // Also support /users/{userId} if Customer app stored base profiles there
    match /users/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }

    // ==========================================
    // 6. PARTNER PROFILES (Partner App compatibility)
    // Partners cannot self-approve or manipulate their payout balances
    // ==========================================
    match /partners/{partnerId} {
      allow read: if isAdmin() || isPartner(partnerId);
      // Partners can register their initial onboarding profile
      allow create: if isAuthenticated() && (
        request.auth.uid == partnerId ||
        request.resource.data.uid == request.auth.uid
      );
      // Partners can only update contact info & availability, NOT status, earnings, or ratings
      allow update: if hasAdminRole('OPERATIONS_ADMIN') || (
        isPartner(partnerId) && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 
          'totalEarnings', 
          'pendingPayout', 
          'rating', 
          'completedJobsCount',
          'rejectionReason'
        ])
      );
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 7. SERVICES & AUTHORITATIVE PRICING CATALOG
    // Read-only for customers and partners; writable ONLY by authorized Admins
    // ==========================================
    match /services/{serviceId} {
      allow read: if true; // Public catalog for mobile clients
      allow write: if hasAdminRole('OPERATIONS_ADMIN') || isSuperAdmin();
    }

    // ==========================================
    // 8. BOOKINGS LIFECYCLE
    // Strict protection against client-side price & booking amount tampering
    // ==========================================
    match /bookings/{bookingId} {
      allow read: if isAdmin() || 
                     (isAuthenticated() && (
                       resource.data.customerId == request.auth.uid || 
                       resource.data.partnerId == request.auth.uid
                     ));
      // Customers can create bookings, but cannot set arbitrary status or forge customerId
      allow create: if isAuthenticated() && 
                       request.resource.data.customerId == request.auth.uid &&
                       request.resource.data.bookingStatus in ['CREATED', 'PENDING'];
      // Status progression & lifecycle updates
      allow update: if isAdmin() || (
        isAuthenticated() && (
          // Customer can cancel if currently in created/assigned stage
          (resource.data.customerId == request.auth.uid && 
           request.resource.data.bookingStatus == 'CANCELLED' &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookingStatus', 'cancellationReason', 'cancelledBy', 'updatedAt'])) ||
          // Partner can advance assigned job status without tampering with pricing or customer assignment
          (resource.data.partnerId == request.auth.uid && 
           !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'totalAmount', 
             'partnerPayoutAmount', 
             'companyCommissionAmount', 
             'customerId', 
             'partnerId',
             'serviceId',
             'packageId'
           ]))
        )
      );
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 9. SERVICE CHANGE PROPOSALS
    // Partner can submit proposal, but ONLY Admin can approve/enforce
    // ==========================================
    match /service_changes/{changeId} {
      allow read: if isAdmin() || 
                     (isAuthenticated() && (
                       resource.data.partnerId == request.auth.uid || 
                       resource.data.customerId == request.auth.uid
                     ));
      allow create: if isAuthenticated(); // Partner requests on-site change
      allow update: if hasAdminRole('OPERATIONS_ADMIN');
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 10. PAYOUTS & REFUNDS (Treasury Operations)
    // Strictly managed by Finance & Super Admin
    // ==========================================
    match /payouts/{payoutId} {
      allow read: if hasAdminRole('FINANCE_ADMIN') || 
                     (isAuthenticated() && resource.data.partnerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.partnerId == request.auth.uid;
      allow update: if hasAdminRole('FINANCE_ADMIN');
      allow delete: if isSuperAdmin();
    }

    match /refunds/{refundId} {
      allow read: if hasAdminRole('FINANCE_ADMIN') ||
                     (isAuthenticated() && resource.data.customerId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update: if hasAdminRole('FINANCE_ADMIN');
      allow delete: if isSuperAdmin();
    }

    // ==========================================
    // 11. NOTIFICATIONS & SYSTEM CONFIGURATION
    // ==========================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /system_settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isSuperAdmin();
    }
  }
}
